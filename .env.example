# PostgreSQL — Neon (recommended) or Supabase
#
# Neon:     Dashboard → Connect → copy the "Pooled connection" string into DATABASE_URL,
#           then untick "Connection pooling" and copy that string into DIRECT_URL.
# Supabase: Project → Connect → ORMs → Prisma — copy both values shown there.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/invoicing?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/invoicing?sslmode=require"

# NextAuth
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first admin user
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
